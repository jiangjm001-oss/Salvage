# ============================================
# Unity Project .gitignore
# For Blank Salvager Project
# ============================================

# --------------------------------------------
# Unity Auto-Generated Folders (Must Exclude)
# --------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# --------------------------------------------
# Unity Meta Files (No Value for Code Analysis)
# --------------------------------------------
*.meta

# --------------------------------------------
# Unity Asset Files (Usually No Need for Version Control)
# --------------------------------------------
# Scene files
*.unity

# Prefab files
*.prefab

# Asset files
*.asset

# Animation files
*.anim
*.controller

# Materials and shaders
*.mat
*.shader
*.shadergraph

# Light data
*.lighting
*.giparams

# Timeline
*.playable

# Unity Package
*.unitypackage

# --------------------------------------------
# Audio/Video Assets (Large Files, Exclude as Needed)
# --------------------------------------------
# Audio files
*.wav
*.mp3
*.ogg
*.aiff

# Video files
*.mp4
*.mov
*.avi

# --------------------------------------------
# Image Assets (Large Files, Exclude as Needed)
# --------------------------------------------
*.png
*.jpg
*.jpeg
*.psd
*.tga
*.gif
*.bmp
*.tiff
*.webp

# --------------------------------------------
# Font Files
# --------------------------------------------
*.ttf
*.otf

# --------------------------------------------
# TextMesh Pro Generated Files
# --------------------------------------------
TextMesh Pro/

# --------------------------------------------
# Visual Studio / Rider IDE Files
# --------------------------------------------
.vs/
.vscode/
.idea/

# Solution and Project files (Unity auto-generates these)
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# --------------------------------------------
# macOS System Files
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# --------------------------------------------
# Windows System Files
# --------------------------------------------
Thumbs.db
Thumbs.db.meta
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# --------------------------------------------
# Linux System Files
# --------------------------------------------
*~
.directory
.Trash-*

# --------------------------------------------
# Crash Logs and Debug Files
# --------------------------------------------
sysinfo.txt
*.stackdump
*.log

# --------------------------------------------
# Unity Cloud Build
# --------------------------------------------
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# --------------------------------------------
# Plastic SCM (Unity Version Control)
# --------------------------------------------
.plastic/

# --------------------------------------------
# Unity Editor Temporary Assets
# --------------------------------------------
ExportedObj/
.consulo/

# --------------------------------------------
# Unity Auto Backup
# --------------------------------------------
**/AutoSave*
*.backup

# --------------------------------------------
# Optional: Large Third-Party Plugins (Uncomment if Needed)
# --------------------------------------------
# Assets/Plugins/
# Assets/Standard Assets/

# --------------------------------------------
# Temporary Development Files
# --------------------------------------------
Temp.txt
*_FIX_GUIDE.md
*_REFERENCE.md
*_SUMMARY.md

# --------------------------------------------
# Save Data Files (Development Test, May Keep for Release)
# --------------------------------------------
# Uncomment if you don't want to upload local save files
# PlayerPrefs.txt
# *.sav
# *.dat

# --------------------------------------------
# IMPORTANT: What Should Be Kept and Uploaded
# --------------------------------------------
# 1. Assets/Scripts/**/*.cs      - All C# scripts (core code)
# 2. ProjectSettings/            - Project configuration
# 3. Packages/manifest.json      - Dependency package configuration
# 4. README.md                   - Project documentation
# 5. Assets/Resources/**/*.txt   - README and other doc files
#
# If you need to upload specific asset files (like key images/audio),
# you can add exception rules in .gitignore, for example:
# !Assets/Resources/Audio/BGM.mp3
# !Assets/Sprites/Logo.png
# ============================================
