# ============================================
# Unity项目 .gitignore 配置文件
# 用于 Blank Salvager (空白打捞人) 项目
# ============================================

# --------------------------------------------
# Unity 自动生成的文件夹（必须排除）
# --------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# --------------------------------------------
# Unity 元数据文件（对代码分析无用）
# --------------------------------------------
*.meta

# --------------------------------------------
# Unity 资源文件（通常不需要版本控制）
# --------------------------------------------
# Scene 文件
*.unity

# Prefab 文件
*.prefab

# Asset 文件
*.asset

# 动画文件
*.anim
*.controller

# 材质和着色器
*.mat
*.shader
*.shadergraph

# Light 数据
*.lighting
*.giparams

# Timeline
*.playable

# Unity Package
*.unitypackage

# --------------------------------------------
# 音视频资源（文件大，按需排除）
# --------------------------------------------
# 音频文件
*.wav
*.mp3
*.ogg
*.aiff

# 视频文件
*.mp4
*.mov
*.avi

# --------------------------------------------
# 图像资源（文件大，按需排除）
# --------------------------------------------
*.png
*.jpg
*.jpeg
*.psd
*.tga
*.gif
*.bmp
*.tiff
*.webp

# --------------------------------------------
# 字体文件
# --------------------------------------------
*.ttf
*.otf

# --------------------------------------------
# TextMesh Pro 生成文件
# --------------------------------------------
TextMesh Pro/

# --------------------------------------------
# Visual Studio / Rider IDE 文件
# --------------------------------------------
.vs/
.vscode/
.idea/

# Solution 和 Project 文件（Unity会自动生成）
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --------------------------------------------
# macOS 系统文件
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# --------------------------------------------
# Windows 系统文件
# --------------------------------------------
Thumbs.db
Thumbs.db.meta
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# --------------------------------------------
# Linux 系统文件
# --------------------------------------------
*~
.directory
.Trash-*

# --------------------------------------------
# 崩溃日志和调试文件
# --------------------------------------------
sysinfo.txt
*.stackdump
*.log

# --------------------------------------------
# Unity 云构建
# --------------------------------------------
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# --------------------------------------------
# Plastic SCM（Unity版本控制）
# --------------------------------------------
.plastic/

# --------------------------------------------
# Unity 编辑器临时资源
# --------------------------------------------
ExportedObj/
.consulo/

# --------------------------------------------
# Unity 自动备份
# --------------------------------------------
**/AutoSave*
*.backup

# --------------------------------------------
# 可选：大型第三方插件（按需取消注释）
# --------------------------------------------
# Assets/Plugins/
# Assets/Standard Assets/

# --------------------------------------------
# 保存数据文件（开发测试用，正式版可能要保留）
# --------------------------------------------
# 如果不想上传本地存档，取消下面的注释
# PlayerPrefs.txt
# *.sav
# *.dat

# --------------------------------------------
# ⭐ 特别说明 ⭐
# --------------------------------------------
# 本项目应该保留并上传的内容：
# 1. Assets/Scripts/**/*.cs      ← 所有 C# 脚本（核心代码）
# 2. ProjectSettings/            ← 项目配置
# 3. Packages/manifest.json      ← 依赖包配置
# 4. README.md                   ← 项目文档
# 5. Assets/Resources/**/*.txt   ← README等文档文件
#
# 如果你需要上传特定的资源文件（如关键图片/音频），
# 可以在.gitignore中添加例外规则，例如：
# !Assets/Resources/Audio/BGM.mp3
# !Assets/Sprites/Logo.png
# ============================================